{
  "display_information": {
    "name": "Muse Slack Bridge",
    "description": "Shared Socket Mode transport between Slack and Muse AI bots.",
    "background_color": "#1D1C1D"
  },
  "features": {
    "bot_user": {
      "display_name": "Muse Bridge",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "groups:history",
        "groups:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.groups"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
